rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User accounts & synchronized cloud data
    match /users/{userId} {
      allow get, delete: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) 
                    && isValidId(userId) 
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(userId) 
                    && isValidId(userId) 
                    && request.resource.data.userId == resource.data.userId;
    }

    // Study Rooms for collaborative group focus
    match /rooms/{roomCode} {
      allow get: if isSignedIn() && isValidId(roomCode);
      allow list: if false;
      allow create: if isSignedIn() 
                    && isValidId(roomCode) 
                    && request.resource.data.hostId == request.auth.uid;
      allow update: if isSignedIn() 
                    && isValidId(roomCode)
                    && (resource.data.hostId == request.auth.uid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'memberCount', 'timer']));
      allow delete: if isSignedIn() 
                    && isValidId(roomCode) 
                    && resource.data.hostId == request.auth.uid;

      // Room participants & live presence
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() 
                              && (memberId == request.auth.uid || request.resource.data.userId == request.auth.uid);
        allow delete: if isSignedIn() 
                      && (memberId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostId == request.auth.uid);
      }

      // Room chat & motivation reactions
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() 
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isSignedIn() 
                              && (resource.data.senderId == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostId == request.auth.uid);
      }
    }
  }
}
